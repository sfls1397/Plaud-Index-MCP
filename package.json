{
  "name": "plaud-index-mcp",
  "version": "0.1.0",
  "description": "Always-on Plaud indexer plus short-lived stdio query MCP for local semantic search of notes and transcripts",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "plaud-index-mcp": "./dist/cli.js",
    "plaud-index-indexer": "./dist/cli.js"
  },
  "author": "Peter Coates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfls1397/plaud-index-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sfls1397/plaud-index-mcp/issues"
  },
  "homepage": "https://github.com/sfls1397/plaud-index-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "plaud",
    "transcript",
    "semantic-search",
    "lancedb",
    "indexer"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/cli.js",
    "indexer": "node dist/cli.js --mode=indexer",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.22.3",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
